DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_tracker
NUXT_SESSION_PASSWORD=change-this-to-a-random-string-at-least-32-characters-long

# Used once by `npm run db:seed` to provision the household + both accounts.
# Not read at runtime — safe to remove from .env after seeding.
HOUSEHOLD_NAME=Our Household
HOUSEHOLD_CURRENCY=GBP
SEED_USER1_EMAIL=you@example.com
SEED_USER1_PASSWORD=change-this-temporary-password
SEED_USER1_NAME=You
SEED_USER2_EMAIL=partner@example.com
SEED_USER2_PASSWORD=change-this-temporary-password
SEED_USER2_NAME=Partner
